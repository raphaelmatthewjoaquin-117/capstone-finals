@gateway = http://localhost:5100
@catalogProduct = 11111111-1111-1111-1111-111111111111
@token = paste-customer-access-token-here
@adminToken = paste-admin-access-token-here
@orderId = paste-order-id-here
@correlationId = 33333333-3333-4333-8333-333333333333

### Public catalog (no token required)
GET {{gateway}}/catalog/v1/products

### Register a Customer
POST {{gateway}}/identity/v1/register
Content-Type: application/json

{
  "email": "customer@example.test",
  "password": "replace-this-with-a-long-password"
}

### Log in as Customer; copy accessToken into @token
POST {{gateway}}/identity/v1/login
Content-Type: application/json

{
  "email": "customer@example.test",
  "password": "replace-this-with-a-long-password"
}

### Place successful order (copy response id into @orderId)
POST {{gateway}}/orders/v1/orders
Authorization: Bearer {{token}}
X-Correlation-ID: {{correlationId}}
Content-Type: application/json

{
  "productId": "{{catalogProduct}}",
  "quantity": 1,
  "simulatePaymentFailure": false
}

### Check order status/history (poll while Compose saga is Pending)
GET {{gateway}}/orders/v1/orders/{{orderId}}
Authorization: Bearer {{token}}
X-Correlation-ID: {{correlationId}}

### Development-only: inject one transient Catalog product-detail failure
POST {{gateway}}/catalog/v1/chaos/fail-next/1

### Trigger saga compensation with simulated payment failure
POST {{gateway}}/orders/v1/orders
Authorization: Bearer {{token}}
X-Correlation-ID: {{correlationId}}
Content-Type: application/json

{
  "productId": "{{catalogProduct}}",
  "quantity": 1,
  "simulatePaymentFailure": true
}

### Anonymous Admin action (expect 401)
POST {{gateway}}/inventory/v1/stock/{{catalogProduct}}/adjust
Content-Type: application/json

{
  "delta": 1
}

### Customer token on Admin-only action (expect 403)
POST {{gateway}}/inventory/v1/stock/{{catalogProduct}}/adjust
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "delta": 1
}

### Log in as seeded Admin; use SEED_ADMIN_EMAIL and SEED_ADMIN_PASSWORD from .env
POST {{gateway}}/identity/v1/login
Content-Type: application/json

{
  "email": "admin@example.test",
  "password": "replace-with-the-SEED_ADMIN_PASSWORD-from-.env"
}

### Admin-only action with an Admin token (expect 200)
POST {{gateway}}/inventory/v1/stock/{{catalogProduct}}/adjust
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "delta": 1
}
